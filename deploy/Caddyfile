# Public entry point. Caddy gets and renews the Let's Encrypt certificate on its
# own; HTTPS is required because browsers only allow the webcam on secure origins.
{$DOMAIN} {
	encode zstd gzip

	# Video uploads go through the frontend's /api proxy.
	request_body {
		max_size 500MB
	}

	reverse_proxy frontend:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
