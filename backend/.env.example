# Copy to .env and fill in your own key. Never commit .env.
# Set ONE of these. Gemini is used if both are set.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# CLAUDE_MODEL=claude-opus-5

# Presage SmartSpectra key for breathing vitals (used by the frontend server).
# Get one at https://physiology.presagetech.com
SMARTSPECTRA_API_KEY=
